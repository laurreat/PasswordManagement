<?xml version="1.0" encoding="utf-8"?>
<!--
  The vault and the sync folder URI live only on this device. Device-to-device
  transfer still happens on Android 12+ even with allowBackup="false", so the
  rules exclude every domain explicitly instead of trusting the flag alone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
