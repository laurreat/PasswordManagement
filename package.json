{
  "name": "localpass",
  "version": "1.1.0",
  "description": "LocalPass - Gestor de contraseñas seguro 100% offline",
  "author": "LocalPass",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:next\" \"npm run dev:electron\"",
    "dev:next": "next dev -p 9002",
    "dev:electron": "wait-on http://localhost:9002 && node -e \"delete process.env.ELECTRON_RUN_AS_NODE; const { spawn } = require('child_process'); const p = spawn(require('electron'), ['.'], { stdio: 'inherit', env: process.env }); p.on('exit', c => process.exit(c));\"",
    "copy:icon": "node -e \"const fs=require('fs');const p=require('path');['icon.svg','icon.png'].forEach(f=>{const src=p.join('public',f);const dst=p.join('out',f);if(fs.existsSync(src))fs.copyFileSync(src,dst);})\"",
    "build": "run-s build:next copy:icon build:electron",
    "build:next": "next build",
    "build:electron": "electron-builder --publish never",
    "build:linux": "run-s build:next copy:icon build:electron:linux",
    "build:electron:linux": "electron-builder --linux --publish never",
    "android:sync": "run-s build:next android:copy",
    "android:copy": "cap sync android",
    "android:open": "cap open android",
    "release:collect": "node scripts/collect-release.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.475.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-day-picker": "^9.11.3",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^22",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "concurrently": "^9.0.1",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.localpass.app",
    "productName": "LocalPass",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "electron/**",
      "public/**",
      "package.json",
      "!node_modules/**"
    ],
    "asarUnpack": [
      "out/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signExecutable": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "Offline password manager with local encrypted sync",
      "maintainer": "Laurreat <laurreat@users.noreply.github.com>",
      "executableName": "localpass",
      "desktop": {
        "entry": {
          "Name": "LocalPass",
          "Comment": "Offline password manager",
          "Categories": "Utility;Security;"
        }
      }
    },
    "appImage": {
      "artifactName": "LocalPass-${version}-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "LocalPass-${version}-${arch}.deb",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "LocalPass-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "LocalPass-${version}-portable.exe"
    }
  }
}
